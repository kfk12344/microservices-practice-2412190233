<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 4.0.x 的 starter 在 4.0 起做过重命名：
        spring-boot-starter-web    -> spring-boot-starter-webmvc
      （4.0.8 里旧名 spring-boot-starter-web 只到 4.0.0 为止，继续用会解析失败）
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.zjgsu</groupId>
    <artifactId>health-diet-tracker</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>health-diet-tracker</name>
    <description>个人健康饮食记录管理系统 —— 单体应用（Week 03 起步，Week 04 接入持久化）</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Mockito 版本与 Spring Boot 4.0.8 的依赖管理保持一致 -->
        <mockito.version>5.20.0</mockito.version>
    </properties>

    <dependencies>
        <!-- Web MVC：GET /api/hello 等 REST 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Actuator：/actuator/health 运行状态检查 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 参数校验：DTO 上的 @NotBlank / @Positive 等约束 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 数据库持久化：Spring Data JPA + Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 生产/本地运行使用的数据库驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          内存数据库 H2，两种用途：
            1) 测试：./mvnw test 用它跑，不依赖本机安装 MySQL；
            2) demo profile：本机没装 MySQL 时也能把应用跑起来看接口效果
               （见 application-demo.yml，启动方式写在 README）。
          生产/正式运行使用默认配置连 MySQL，与 H2 无关。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Spring Boot 4 起 Web 层测试的注解与工具被拆到独立模块，@WebMvcTest / MockMvc
          不再随 spring-boot-starter-test 提供，需要显式引入本 starter：
            @WebMvcTest    -> org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest
            TestRestTemplate -> org.springframework.boot.resttestclient.TestRestTemplate
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          TestRestTemplate 的实体类与自动配置都在 spring-boot-resttestclient 模块里。
          它虽然作为 spring-boot-starter-webmvc-test 的传递依赖存在，但需要在测试编译期
          直接可见，否则 @AutoConfigureTestRestTemplate 会在推断 Bean 类型时报
          "Failed to introspect Class ... TestRestTemplateTestAutoConfiguration"。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          spring-boot-resttestclient 的自动配置类引用了
          org.springframework.boot.restclient.RestTemplateBuilder，但该模块的 POM
          并未把它声明为依赖（Spring Boot 4.0.8 的依赖声明缺口），
          结果测试启动时报 NoClassDefFoundError，再被包装成
          "Failed to deduce bean type for TestRestTemplateTestAutoConfiguration"。
          这里显式补上，保证 @AutoConfigureTestRestTemplate 可用。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              JDK 21 起不再允许动态挂载 Java agent，而 Mockito 的 inline mock maker
              默认靠"运行时自我挂载"实现。JDK 25 上若不做处理会直接失败：
                  IllegalStateException: Could not initialize plugin:
                      interface org.mockito.plugins.MockMaker (alternate: null)
              官方给出的做法是把 mockito-core 当作 -javaagent 显式传入。
              因此这里先把该 jar 复制到 target/，再交给 surefire 的 argLine。
              （本机环境：JDK 25.0.4.1 + Spring Boot 4.0.8 + Mockito 5.20.0）
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-mockito-agent</id>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <phase>process-test-classes</phase>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.mockito</groupId>
                                    <artifactId>mockito-core</artifactId>
                                    <version>${mockito.version}</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <stripVersion>true</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${project.build.directory}/mockito-core.jar -Xshare:off</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
