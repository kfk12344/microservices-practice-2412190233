# =============================================================================
# 环境变量模板
#
# 用法：
#     1. 复制成 .env
#          Copy-Item .env.example .env          (Windows PowerShell)
#          cp .env.example .env                 (Linux / macOS / Git Bash)
#     2. 把所有 change-me-... 改成自己的口令（不要用示例里的值）
#     3. .env 已被 .gitignore 排除，不会被提交；只有本模板进仓库
#
# 为什么要单独放 .env：
#     口令属于"部署时才知道"的信息，写进 compose.yaml 会随代码一起公开。
#     把口令抽到 .env，仓库里只留模板，换环境时改 .env 即可，不用动编排文件。
# =============================================================================

# ---- MySQL 超级用户口令（容器初始化用）----
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- 单体版本（第 04/05 周）用的库与账号 ----
MYSQL_USER=hdt
MYSQL_PASSWORD=change-me-app-password
MYSQL_DATABASE=health_diet

# ---- 第 06 周：三个微服务各自的数据库账号口令 ----
# 每个账号只被授权访问自己的库，互相读不到对方的数据
# （授权隔离见 db/init/01-init-databases.sh）
USER_DB_PASSWORD=change-me-user-db-password
FOOD_DB_PASSWORD=change-me-food-db-password
MEAL_DB_PASSWORD=change-me-meal-db-password
